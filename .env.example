# Copy this file to `.env` and adjust the values. `.env` is git-ignored.

# --- PostgreSQL (docker-compose) ---
# 5433 on the host so it does not clash with a locally installed PostgreSQL on 5432.
POSTGRES_DB=movie_hub
POSTGRES_USER=moviehub
POSTGRES_PASSWORD=moviehub
POSTGRES_PORT=5433

# --- pgAdmin ---
PGADMIN_EMAIL=admin@moviehub.dev
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050

# --- Backend (set these in your IDE run configuration or shell; defaults in application.yml match docker-compose) ---
DB_URL=jdbc:postgresql://localhost:5433/movie_hub
DB_USERNAME=moviehub
DB_PASSWORD=moviehub
CORS_ALLOWED_ORIGINS=http://localhost:4200
# TMDB (https://www.themoviedb.org/settings/api): the v3 "API Key" or the v4 "API Read Access Token" both work.
TMDB_API_KEY=
TMDB_LANGUAGE=en-US
# Optional: route TMDB calls through an HTTP proxy when TMDB is blocked on your network (e.g. a VPN's local proxy).
TMDB_PROXY=

# --- Security ---
# Base64 secret of at least 32 bytes. Generate one with: openssl rand -base64 48
# If empty, a random key is generated at startup (all tokens become invalid on restart).
JWT_SECRET=
# Admin account created at startup if it does not exist (leave the password empty to skip).
ADMIN_EMAIL=admin@moviehub.dev
ADMIN_PASSWORD=

# Uploaded files directory (avatars)
STORAGE_DIR=./storage
